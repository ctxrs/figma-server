{
  "name": "@ctxrs/figma-server",
  "version": "0.2.0",
  "description": "A local MCP-over-HTTP bridge for real Figma browser sessions",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/ctxrs/figma-server.git" },
  "homepage": "https://github.com/ctxrs/figma-server#readme",
  "bugs": { "url": "https://github.com/ctxrs/figma-server/issues" },
  "type": "module",
  "bin": {
    "figma-server": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test",
    "start": "node dist/src/cli.js run",
    "format:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
